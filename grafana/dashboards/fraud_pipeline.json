{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Decisions Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(fraud_predictions_total[5m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "title": "Fraud Score Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "increase(fraud_composite_score_bucket[1h])",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "Prediction Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(fraud_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(fraud_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(fraud_prediction_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Total Predictions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(fraud_predictions_total)"
        }
      ]
    },
    {
      "title": "Model Version",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "noValue": "local pkl"
        }
      },
      "targets": [
        {
          "expr": "fraud_model_version",
          "legendFormat": "version"
        }
      ]
    },
    {
      "title": "Decision Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum(fraud_predictions_total) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(fraud_predictions_total[1m]))",
          "legendFormat": "requests/s"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["fraud-detection"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Fraud Detection Pipeline",
  "uid": "fraud-pipeline-dashboard"
}
